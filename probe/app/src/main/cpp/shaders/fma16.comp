#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { float o[]; };
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
    uint id = gl_GlobalInvocationID.x;
    f16vec2 a0 = f16vec2(float(id) * 1e-6), a1 = a0 + f16vec2(0.1hf), a2 = a0 + f16vec2(0.2hf), a3 = a0 + f16vec2(0.3hf);
    f16vec2 a4 = a0 + f16vec2(0.4hf), a5 = a0 + f16vec2(0.5hf), a6 = a0 + f16vec2(0.6hf), a7 = a0 + f16vec2(0.7hf);
    const f16vec2 m = f16vec2(0.999hf);
    for (uint i = 0u; i < pc.iters; i++) {
        a0 = fma(a0, m, f16vec2(0.001hf)); a1 = fma(a1, m, f16vec2(0.002hf));
        a2 = fma(a2, m, f16vec2(0.003hf)); a3 = fma(a3, m, f16vec2(0.004hf));
        a4 = fma(a4, m, f16vec2(0.005hf)); a5 = fma(a5, m, f16vec2(0.006hf));
        a6 = fma(a6, m, f16vec2(0.007hf)); a7 = fma(a7, m, f16vec2(0.008hf));
    }
    f16vec2 s = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
    o[id] = float(s.x) + float(s.y);
}

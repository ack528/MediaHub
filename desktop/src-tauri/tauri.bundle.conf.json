{
  "$schema": "https://schema.tauri.app/config/2",
  "version": "1.1.1",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MediaHub",
    "shortDescription": "MediaHub 服务端管理程序",
    "longDescription": "管理局域网媒体网关 MediaHub:媒体库、缓存、转码、账号与网络设置。",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../dist/stage/runtime": "runtime",
      "../../dist/stage/tools": "tools"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MediaHub 桌面管理程序的窗口权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path"
  ]
}
